            options: ["Film Rachanun", "Jan Ployshompoo", "Fah Yongwaree", "Piploy Kanyarat"],
            answer: "Film Rachanun",
            fact: "Film 擁有甜美外型與細膩演技，與 Namtan 組成的 NamtanFilm 擁有極高人氣。"
        },
        {
            category: "GMMTV 副 CP 魅力",
            question: "在《地球傾斜23.5度》中飾演外冷內熱的「Aylin」（自稱外星人），讓觀眾印象深刻的 GMMTV 女藝人是？",
            options: ["View Benyapa", "June Wanwimol", "Ciize Rutricha", "Earn Preeyaphat"],
            answer: "View Benyapa",
            fact: "View 憑藉《23.5》中呆萌又酷帥的 Aylin 一角圈粉無數！"
        },
        {
            category: "GMMTV 陣容",
            question: "在《地球傾斜23.5度》中飾演勇敢追愛「Luna」，經常與 View 搭檔的 GMMTV 女藝人是？",
            options: ["June Wanwimol", "Jamie Juthapich", "JingJing Yu", "Pahn Pathitta"],
            answer: "June Wanwimol",
            fact: "June 曾出演過《特長生》、《只因我們天生一對》等多部熱門劇集，演技相當成熟。"
        },
        {
            category: "GMMTV 新生代 CP",
            question: "主演 GMMTV 百合劇《Us 我們的愛》（改編自小說），與 Bonnie 搭檔的短髮酷帥女藝人是？",
            options: ["Emi Thasorn", "Lookjun Bhasidi", "Bimbeam Praekwan", "Mook Worranit"],
            answer: "Emi Thasorn",
            fact: "Emi 擁有獨特的文藝與帥氣氣質，與 Bonnie 組成的 EmiBonnie 是 GMMTV 備受矚目的新生代百合組合。"
        },
        {
            category: "GMMTV 陣容",
            question: "在《Pluto 冥王星之戀》中也有亮眼表現，與好姐妹 Ciize 經常一起拍片互動的 GMMTV 女藝人是？",
            options: ["Kapook Phatchara", "Godji Tachakorn", "Goy Arachaporn", "Gigie Chanunphat"],
            answer: "Kapook Phatchara",
            fact: "Kapook 與 Ciize 的好交情與超強 CP 感，讓「KapookCiize」在粉絲圈中呼聲極高！"
        },
        {
            category: "GMMTV 唱跳才女",
            question: "曾是女團 SIZZY 成員，身材嬌小但舞蹈實力超強，常與 Kapook 組隊的 GMMTV 女藝人是？",
            options: ["Ciize Rutricha", "Jane Ramida", "Jan Ployshompoo", "Aye Sarunchana"],
            answer: "Ciize Rutricha",
            fact: "Ciize（西施）充滿活力且極具綜藝感，在《23.5》中也有客串演出。"
        },
        {
            category: "GMMTV 氣質女神",
            question: "在 GMMTV 眾多戲劇中展現高冷御姐氣質，並參演《Whale Store xoxo》等百合題材作品的混血感美女是？",
            options: ["JingJing Yu", "Mim Rattanawadee", "Sammy Samantha", "Parn Nachcha"],
            answer: "JingJing Yu",
            fact: "JingJing 擁有模特兒般的修長身材與高級臉，加入 GMMTV 後受到許多關注。"
        },
        {
            category: "泰百天花板傳奇",
            question: "主演泰國首部爆紅百合劇《粉紅理論 (GAP The Series)》，飾演霸道總裁「Sam」的是哪位藝人？",
            options: ["Freen Sarocha", "Becky Armstrong", "Engfa Waraha", "Charlotte Austin"],
            answer: "Freen Sarocha",
            fact: "Freen 與 Becky 組成的 FreenBecky 席捲全球，開啟了泰國 GL 劇的黃金時代！"
        },
        {
            category: "泰百人氣王",
            question: "擁有泰英混血血統，在《粉紅理論》中飾演可愛實習生「Mon」的女藝人是？",
            options: ["Becky Armstrong", "Orm Kornnaphat", "Yoko Apasra", "Sonya Saranphat"],
            answer: "Becky Armstrong",
            fact: "Becky 年紀輕輕便展現驚人魅力，除了演技外，也是時尚界的寵兒。"
        },
        {
            category: "CH3 現象級 CP",
            question: "擁有中泰混血基因、粵語流利，在三台百合劇《我們的秘密》中飾演醫生「Fahlada」的是？",
            options: ["Lingling Kwong (鄺玲玲)", "Orm Kornnaphat", "Faye Peraya", "Lookmhee Punyapat"],
            answer: "Lingling Kwong (鄺玲玲)",
            fact: "鄺玲玲在香港長大，憑藉精緻五官與深情演技在《我們的秘密》中一炮而紅！"
        },
        {
            category: "CH3 現象級 CP",
            question: "在《我們的秘密》中飾演大明星「Earn」，私下個性活潑開朗、愛撒嬌的金髮甜心是？",
            options: ["Orm Kornnaphat", "Love Pattranite", "Film Rachanun", "Miu Natsha"],
            answer: "Orm Kornnaphat",
            fact: "LingOrm（鄺玲玲與 Orm）憑藉《我們的秘密》成為亞洲現象級的百合 CP。"
        },
        {
            category: "選美皇后 CP",
            question: "曾獲得泰國萬國小姐 (Miss Grand Thailand) 冠軍，與 Charlotte Austin 組成超人氣 CP「Englot」的是？",
            options: ["Engfa Waraha", "Faye Peraya", "Lux Sulax", "Heidi Amanda"],
            answer: "Engfa Waraha",
            fact: "Engfa 歌喉極佳且舞台魅力十足，與 Charlotte 的真實互動吸引無數死忠粉絲。"
        },
        {
            category: "年下年上虐戀",
            question: "主演《空白 (Blank The Series)》，以成熟優雅的御姐魅力與 Yoko 搭檔的資深選美冠軍是？",
            options: ["Faye Peraya", "Namtan Tipnaree", "Jane Ramida", "Grace Budsarin"],
            answer: "Faye Peraya",
            fact: "Faye 曾是 2016 年泰國萬國小姐冠軍，在《空白》中飾演的 Khun Nueng 氣場全開。"
        }
    ];

    let currentQuestions = [];
    let currentIndex = 0;
    let score = 0;
    let streak = 0;
    const totalQuestions = 10;

    function shuffleArray(array) {
        let shuffled = [...array];
        for (let i = shuffled.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
        }
        return shuffled;
    }

    function startGame() {
        currentQuestions = shuffleArray(questionBank).slice(0, totalQuestions);
        currentIndex = 0;
        score = 0;
        streak = 0;

        document.getElementById('start-screen').classList.add('hidden');
        document.getElementById('result-screen').classList.add('hidden');
        document.getElementById('quiz-screen').classList.remove('hidden');

        updateStatus();
        loadQuestion();
    }

    function updateStatus() {
        document.getElementById('question-num').innerText = currentIndex + 1;
        document.getElementById('score').innerText = score;
        document.getElementById('streak').innerText = streak;
    }

    function loadQuestion() {
        const q = currentQuestions[currentIndex];
        document.getElementById('category-badge').innerText = q.category;
        document.getElementById('question-text').innerText = q.question;
        
        const feedbackBox = document.getElementById('feedback-box');
        feedbackBox.classList.remove('show');
        feedbackBox.innerText = '';
        
        document.getElementById('next-btn').classList.add('hidden');

        const optionsContainer = document.getElementById('options-container');
        optionsContainer.innerHTML = '';

        const shuffledOptions = shuffleArray(q.options);

        shuffledOptions.forEach(option => {
            const btn = document.createElement('button');
            btn.className = 'option-btn';
            btn.innerText = option;
            btn.onclick = () => selectAnswer(btn, option, q);
            optionsContainer.appendChild(btn);
        });
    }

    function selectAnswer(selectedBtn, selectedOption, questionObj) {
        const allBtns = document.querySelectorAll('.option-btn');
        allBtns.forEach(btn => btn.disabled = true);

        const feedbackBox = document.getElementById('feedback-box');
        feedbackBox.classList.add('show');

        if (selectedOption === questionObj.answer) {
            selectedBtn.classList.add('correct');
            streak++;
            const bonus = streak >= 2 ? 5 : 0;
            score += (10 + bonus);
            feedbackBox.innerHTML = `✅ <strong>答對了！</strong> ${bonus > 0 ? `(連擊獎勵 +${bonus}分！)` : ''}<br><span style="color:#555;">💡 小知識：${questionObj.fact}</span>`;
        } else {
            selectedBtn.classList.add('wrong');
            streak = 0;
            allBtns.forEach(btn => {
                if (btn.innerText === questionObj.answer) {
                    btn.classList.add('correct');
                }
            });
            feedbackBox.innerHTML = `❌ <strong>答錯囉！</strong> 正確答案是 <strong>${questionObj.answer}</strong>。<br><span style="color:#555;">💡 小知識：${questionObj.fact}</span>`;
        }

        updateStatus();
        document.getElementById('next-btn').classList.remove('hidden');
    }

    function nextQuestion() {
        currentIndex++;
        if (currentIndex < totalQuestions) {
            updateStatus();
            loadQuestion();
        } else {
            showResults();
        }
    }

    function showResults() {
        document.getElementById('quiz-screen').classList.add('hidden');
        document.getElementById('result-screen').classList.remove('hidden');
        document.getElementById('final-score').innerText = score;

        const rankTitle = document.getElementById('rank-title');
        const rankDesc = document.getElementById('rank-desc');

        if (score >= 100) {
            rankTitle.innerText = "👑 泰百百科全書・骨灰級女神粉";
            rankDesc.innerText = "太強了！無論是 GMMTV 還是各大廠牌的女藝人，全都逃不過你的法眼！";
        } else if (score >= 70) {
            rankTitle.innerText = "💖 資深泰百追劇達人";
            rankDesc.innerText = "你對泰百圈非常熟悉！大部分的熱門 CP 與作品你都如數家珍。";
        } else if (score >= 40) {
            rankTitle.innerText = "🌱 潛力股泰百新粉";
            rankDesc.innerText = "已經認識不少女神囉！多刷幾部 GMMTV 的百合劇很快就能晉級！";
        } else {
            rankTitle.innerText = "🐣 剛入坑的萌新觀察員";
            rankDesc.innerText = "歡迎來到泰百的坑底！快去補看《地球傾斜23.5度》和《Pluto 冥王星之戀》吧！";
        }
    }
</script>

</body>
</html>
